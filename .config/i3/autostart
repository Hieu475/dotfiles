# Programs started with i3. exec_always lines re-run on every reload, exec lines only at login.

# XDG autostart entries (needed for things like dunst, polkit agents)
exec --no-startup-id dex --autostart --environment i3

# lock (black) before suspend and when the X screensaver fires
exec --no-startup-id xss-lock --transfer-sleep-lock -- ~/.config/i3/locker.sh

# idle timers: screensaver/lock after 5 min of inactivity, displays off after 6 min
# (DPMS was 10 min; "dpms 0 0 360" = no standby, no suspend, off at 360 s)
exec_always --no-startup-id xset s 300 5
exec_always --no-startup-id xset dpms 0 0 360

# polkit agent: shows the password dialog for admin actions from GUI apps (Thunar mounts etc.)
exec --no-startup-id /usr/lib/policykit-1-gnome/polkit-gnome-authentication-agent-1

# auto split direction (dwindle-style tiling); restarted on every reload
exec_always --no-startup-id ~/.config/i3/start-autotiling.sh

# battery, lid and power-button handling (volume and battery are shown by the i3blocks bar)
exec --no-startup-id xfce4-power-manager

# wifi tray applet
exec --no-startup-id nm-applet

# solid black background
exec_always --no-startup-id xsetroot -solid "#000000"

# monitors and touchpad (scripts adapt to whatever is plugged in)
exec_always --no-startup-id ~/.config/i3/monitor-setup.sh
exec_always --no-startup-id ~/.config/i3/input-setup.sh

# Vietnamese input: GNOME started ibus for you, i3 does not
exec --no-startup-id ibus-daemon -drx

# compositor (vsync fixes tearing on the hybrid Intel/NVIDIA laptop)
exec --no-startup-id picom

# clipboard history (Flameshot is not started here: `flameshot gui` launches it on demand)
exec --no-startup-id copyq
