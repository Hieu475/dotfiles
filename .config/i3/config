# i3 config (v4), split into files that are loaded in this order.
#   workspaces   - workspace names and which monitor they live on
#   appearance   - font, borders, gaps, colours, status bar
#   rules        - which windows float
#   keybindings  - every shortcut
#   autostart    - programs started with i3
# Scripts live next to this file (toggle-ime.sh, toggle-dropdown.sh, monitor-setup.sh, input-setup.sh).
# Check syntax before reloading:  i3 -C -c ~/.config/i3/config

# Super (Windows key)
set $mod Mod4

include ~/.config/i3/workspaces
include ~/.config/i3/appearance
include ~/.config/i3/rules
include ~/.config/i3/keybindings
include ~/.config/i3/autostart
