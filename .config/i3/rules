# Window rules: which windows float instead of tiling.

for_window [window_role="pop-up"] floating enable
for_window [window_role="task_dialog"] floating enable
for_window [class="Pavucontrol"] floating enable
for_window [class="Arandr"] floating enable
for_window [class="Nm-connection-editor"] floating enable

# btop opened from the bar (CPU / RAM click): small floating window, centred
for_window [class="dev.btop"] floating enable, resize set 60 ppt 60 ppt, move position center

# calendar popup from the bar clock
for_window [class="(?i)zenity"] floating enable

# screenshot overlay and clipboard history
for_window [class="(?i)flameshot"] floating enable, border pixel 0
for_window [class="(?i)copyq"] floating enable

# dropdown terminal (see toggle-dropdown.sh): float, size, centre, park in the scratchpad
for_window [class="dev.dropdown"] floating enable, resize set 55 ppt 55 ppt, move position center, move scratchpad, scratchpad show
