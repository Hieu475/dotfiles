# i3blocks: bar items (left -> right). Click / right-click / scroll actions live in the scripts.
separator=false
separator_block_width=4
markup=pango

[dnd]
command=$HOME/.config/i3blocks/scripts/dnd.sh
interval=30

[ime]
command=$HOME/.config/i3blocks/scripts/ime.sh
interval=10

[wifi]
command=$HOME/.config/i3blocks/scripts/wifi.sh
interval=10

[cpu]
command=$HOME/.config/i3blocks/scripts/cpu.sh
interval=3

[mem]
command=$HOME/.config/i3blocks/scripts/mem.sh
interval=5

[volume]
command=$HOME/.config/i3blocks/scripts/volume.sh
interval=10
signal=11

[battery]
command=$HOME/.config/i3blocks/scripts/battery.sh
interval=20

[clock]
command=$HOME/.config/i3blocks/scripts/clock.sh
interval=5

[power]
command=$HOME/.config/i3blocks/scripts/power.sh
interval=once
